{
  "rewrites": [{ "source": "/((?!api/|assets/|.*\\..*).*)", "destination": "/" }],
  "crons": [
    { "path": "/api/cron/refresh-tool-catalog?group=cutter",   "schedule": "0 18 * * *" },
    { "path": "/api/cron/refresh-tool-catalog?group=abrasive", "schedule": "5 18 * * *" },
    { "path": "/api/cron/refresh-tool-catalog?group=detail",   "schedule": "10 18 * * *" },
    { "path": "/api/cron/refresh-tool-catalog?group=paint",    "schedule": "15 18 * * *" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(), geolocation=(), payment=(), usb=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.supabase.co https://*.yimg.jp https://*.rakuten.co.jp https://*.r10s.jp; font-src 'self' data:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://*.supabase.in; media-src 'self' blob:; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    }
  ]
}
