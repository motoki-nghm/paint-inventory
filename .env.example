VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_PUBLIC_ANON_KEY"

# Server-only (Vercel env). Used by /api/product-lookup.
# At least one of these must be set, otherwise barcode → product name lookup
# will fail with a clear "API 未設定" toast in the scan UI.
#   YAHOO_APP_ID    — Yahoo! Developer Network appid (recommended for JAN exact match)
#   RAKUTEN_APP_ID  — Rakuten Web Service applicationId (used as fallback)
# YAHOO_APP_ID="YOUR_YAHOO_APP_ID"
# RAKUTEN_APP_ID="YOUR_RAKUTEN_APP_ID"
