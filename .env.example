VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_PUBLIC_ANON_KEY"

# Server-only (Vercel env). Used by /api/product-lookup and /api/cron/refresh-tool-catalog.
# どちらかが設定されていれば動作する (両方推奨)。
#
# --- Yahoo!ショッピング (推奨・1キーで完結) ---
#   YAHOO_APP_ID    — Yahoo! Developer Network appid
# YAHOO_APP_ID="YOUR_YAHOO_APP_ID"
#
# --- 楽天市場 (2026-05-14 以降は新API・3点セット必須) ---
#   RAKUTEN_APP_ID      — applicationId (新コンソールで再登録した値)
#   RAKUTEN_ACCESS_KEY  — accessKey (同コンソールで発行)
#   RAKUTEN_ORIGIN      — Rakuten Developer に登録したドメイン (省略時は
#                          VERCEL_PROJECT_PRODUCTION_URL → VERCEL_URL の順で自動推定)
# RAKUTEN_APP_ID="YOUR_RAKUTEN_APPLICATION_ID"
# RAKUTEN_ACCESS_KEY="YOUR_RAKUTEN_ACCESS_KEY"
# RAKUTEN_ORIGIN="https://your-paint-inventory.vercel.app"

# Server-only. Used by /api/cron/refresh-tool-catalog (Vercel Cron).
# service_role は RLS をバイパスして tool_catalog テーブルへ書き込むため必須。
# 絶対にクライアント (VITE_*) から参照しないこと。
# SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"
# CRON_SECRET="ランダム文字列 (Vercel Cron が自動で Bearer 付与する)"
